{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"jsx": "preserve",
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "node"]
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
